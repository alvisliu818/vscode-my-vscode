{
  "name": "my-vscode",
  "displayName": "My VS Code",
  "description": "个人扩展合集：① Python 里输入 [[ 或 ./ 自动提示文件路径补全；② 把 .git 外迁的分离 git 仓库绑定到源代码管理面板，直接查看/暂存/提交/推送。",
  "version": "0.6.2",
  "publisher": "autoclaw-local",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/alvisliu818/vscode-my-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/my-vscode.js",
  "scripts": {
    "check": "tsc --noEmit",
    "bundle": "node esbuild.mjs",
    "test": "node test/smoke.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "contributes": {
    "configuration": {
      "title": "My VS Code",
      "properties": {
        "myVscode.autoDiscover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "自动解析工作区根目录下 `*-gl.sh` 包装脚本中的 `--git-dir` / `--work-tree`，生成分离仓库绑定。"
        },
        "myVscode.bindings": {
          "type": "array",
          "default": [],
          "markdownDescription": "手动绑定（自动发现之外的补充）。示例：\n\n```json\n[ { \"workTree\": \"E:/HOME/Code/proj\", \"gitDir\": \"E:/HOME/Code/proj-git\", \"label\": \"proj\" } ]\n```",
          "items": {
            "type": "object",
            "required": [
              "workTree",
              "gitDir"
            ],
            "properties": {
              "workTree": {
                "type": "string",
                "description": "项目工作树目录"
              },
              "gitDir": {
                "type": "string",
                "description": "外迁的 .git 目录"
              },
              "label": {
                "type": "string",
                "description": "源代码管理面板里显示的名称（默认取工作树目录名）"
              },
              "force": {
                "type": "boolean",
                "description": "跳过自管检测强制接管。目录里有有效 .git 指针文件时默认会让给内置 git 扩展；若内置 git 扫不到（如二级深目录）导致存储库不显示，设为 true。"
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "myVscode.refresh",
        "title": "My VS Code: 刷新所有仓库",
        "icon": "$(refresh)"
      },
      {
        "command": "myVscode.reloadBindings",
        "title": "My VS Code: 重新加载绑定"
      },
      {
        "command": "myVscode.showOutput",
        "title": "My VS Code: 打开输出日志"
      },
      {
        "command": "myVscode.commit",
        "title": "My VS Code: 提交已暂存",
        "icon": "$(check)"
      },
      {
        "command": "myVscode.commitAll",
        "title": "My VS Code: 暂存全部并提交"
      },
      {
        "command": "myVscode.checkout",
        "title": "My VS Code: 切换分支",
        "icon": "$(git-branch)"
      },
      {
        "command": "myVscode.push",
        "title": "My VS Code: 推送",
        "icon": "$(arrow-up)"
      },
      {
        "command": "myVscode.pull",
        "title": "My VS Code: 拉取",
        "icon": "$(arrow-down)"
      },
      {
        "command": "myVscode.sync",
        "title": "My VS Code: 同步更改（拉取+推送）",
        "icon": "$(sync)"
      },
      {
        "command": "myVscode.remotes",
        "title": "My VS Code: 管理远程",
        "icon": "$(cloud)"
      },
      {
        "command": "myVscode.publish",
        "title": "My VS Code: 发布分支到远程",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "myVscode.stage",
        "title": "暂存"
      },
      {
        "command": "myVscode.unstage",
        "title": "取消暂存"
      },
      {
        "command": "myVscode.stageAll",
        "title": "暂存全部"
      },
      {
        "command": "myVscode.unstageAll",
        "title": "取消全部暂存"
      },
      {
        "command": "myVscode.discard",
        "title": "放弃更改"
      },
      {
        "command": "myVscode.discardAll",
        "title": "放弃全部更改"
      },
      {
        "command": "myVscode.openChanges",
        "title": "打开差异"
      },
      {
        "command": "myVscode.openFile",
        "title": "打开文件"
      },
      {
        "command": "myVscode.graphPickRepo",
        "title": "My VS Code: 提交图表：选择仓库",
        "icon": "$(git-branch)"
      },
      {
        "command": "myVscode.graphRefresh",
        "title": "My VS Code: 刷新提交图表",
        "icon": "$(refresh)"
      },
      {
        "command": "myVscode.openCommit",
        "title": "查看提交文件差异"
      },
      {
        "command": "myVscode.newSameNameMd",
        "title": "新建同名 MD 文件"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "my-vscode-panel",
          "title": "My VS Code",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "my-vscode-panel": [
        {
          "id": "myVscode.graphView",
          "name": "提交图表"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "myVscode.newSameNameMd",
          "group": "9_myvscode@1",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "scm/repository": [
        {
          "command": "myVscode.checkout",
          "group": "1_header@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.publish",
          "group": "1_header@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.sync",
          "group": "1_header@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.push",
          "group": "1_header@4",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.pull",
          "group": "1_header@5",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.commitAll",
          "group": "2_main@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.stageAll",
          "group": "2_main@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.unstageAll",
          "group": "2_main@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.remotes",
          "group": "2_main@4",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.refresh",
          "group": "3_footer@1",
          "when": "scmProvider == myVscode"
        }
      ],
      "commandPalette": [
        {
          "command": "myVscode.stage",
          "when": "false"
        },
        {
          "command": "myVscode.unstage",
          "when": "false"
        },
        {
          "command": "myVscode.openChanges",
          "when": "false"
        },
        {
          "command": "myVscode.openFile",
          "when": "false"
        },
        {
          "command": "myVscode.openCommit",
          "when": "false"
        },
        {
          "command": "myVscode.graphPickRepo",
          "when": "myVscode.hasRepos"
        },
        {
          "command": "myVscode.graphRefresh",
          "when": "myVscode.hasRepos"
        }
      ],
      "view/title": [
        {
          "command": "myVscode.graphPickRepo",
          "group": "navigation@1",
          "when": "view == myVscode.graphView"
        },
        {
          "command": "myVscode.graphRefresh",
          "group": "navigation@2",
          "when": "view == myVscode.graphView"
        }
      ],
      "scm/title": [
        {
          "command": "myVscode.commit",
          "group": "navigation",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.checkout",
          "group": "navigation",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.refresh",
          "group": "navigation@9",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.stageAll",
          "group": "1_modification",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.commitAll",
          "group": "1_modification@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.unstageAll",
          "group": "1_modification@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.discardAll",
          "group": "2_danger",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.push",
          "group": "3_sync",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.pull",
          "group": "3_sync@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.remotes",
          "group": "3_sync@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.sync",
          "group": "3_sync@4",
          "when": "scmProvider == myVscode"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "myVscode.checkout",
          "group": "1_branch@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.publish",
          "group": "2_sync@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.sync",
          "group": "2_sync@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.push",
          "group": "2_sync@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.pull",
          "group": "2_sync@4",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.remotes",
          "group": "3_remote@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.commitAll",
          "group": "4_changes@1",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.stageAll",
          "group": "4_changes@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.unstageAll",
          "group": "4_changes@3",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.refresh",
          "group": "9_footer@1",
          "when": "scmProvider == myVscode"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "myVscode.stageAll",
          "when": "scmProvider == myVscode && scmResourceGroup == workingTree"
        },
        {
          "command": "myVscode.unstageAll",
          "when": "scmProvider == myVscode && scmResourceGroup == index"
        },
        {
          "command": "myVscode.discardAll",
          "when": "scmProvider == myVscode && scmResourceGroup == workingTree"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "myVscode.openChanges",
          "group": "navigation",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.openFile",
          "group": "navigation@2",
          "when": "scmProvider == myVscode"
        },
        {
          "command": "myVscode.stage",
          "group": "1_modification",
          "when": "scmProvider == myVscode && scmResourceGroup == workingTree"
        },
        {
          "command": "myVscode.unstage",
          "group": "1_modification",
          "when": "scmProvider == myVscode && scmResourceGroup == index"
        },
        {
          "command": "myVscode.discard",
          "group": "2_danger",
          "when": "scmProvider == myVscode && scmResourceGroup == workingTree"
        }
      ]
    }
  }
}
